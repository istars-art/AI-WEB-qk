<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qk.management.mapper.UserMapper">
    <insert id="insert" parameterType="com.qk.model.entity.User">

        INSERT INTO user(username, password, name, phone, email, gender, status,
                    <if test="deptId != null">dept_id,</if>
                    <if test="roleId != null">role_id,</if>
                    <if test="image != null and image!=''">image,</if>
                    <if test="remark != null and remark!=''">remark,</if>
                    create_time,update_time
            )
        VALUES(#{username},#{password},#{name},#{phone},#{email},#{gender},#{status},
            <if test="deptId != null"> #{deptId} ,</if>
            <if test="roleId != null"> #{roleId} , </if>
            <if test="image != null and image !=''">#{image} , </if>
            <if test="remark != null and remark!=''">#{remark} , </if>
            #{createTime},#{updateTime})

    </insert>
    <delete id="deleteByIds">
        DELETE FROM user
        WHERE id IN
        <foreach item="id" collection="ids" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectByCondition" resultType="com.qk.model.entity.dos.UserDO"
            parameterType="com.qk.model.dto.UserPage">
        SELECT
            u.id,
            u.username,
            u.name,
            u.phone,
            u.status,
            u.image,
            u.update_time,
            d.name as deptName,
            r.name as roleName
        FROM user u
            LEFT JOIN dept d ON u.dept_id = d.id
            LEFT JOIN role r ON u.role_id = r.id
        <where>
            <if test="name != null">
                AND u.name LIKE concat('%',#{name},'%')
            </if>
            <if test="phone != null">
                AND u.phone LIKE concat('%',#{phone},'%')
            </if>
            <if test="deptId != null">
                AND u.dept_id = #{deptId}
            </if>
            <if test="status != null">
                AND u.status = #{status}
            </if>
        </where>
        ORDER BY
            u.update_time DESC
    </select>
    <select id="selectByUsernameOrPhoneOrEmailLimitOne" resultType="com.qk.model.entity.User">
        SELECT
            *
        FROM user
        WHERE username = #{username}
        OR phone = #{phone}
        OR email = #{email}
        LIMIT 1
    </select>
    <select id="selectByIds" resultType="com.qk.model.entity.User">
        SELECT
            *
        FROM
            user
        WHERE id IN
        <foreach item="id" collection="ids" separator="," open="(" close=")">
            #{id}
        </foreach>
    </select>
    <select id="selectById" resultType="com.qk.model.entity.User" parameterType="java.lang.Integer">
        SELECT
            *
        FROM
            user
        WHERE
            id = #{id}
    </select>
    <select id="selectByRoleLabel" resultType="com.qk.model.entity.User" parameterType="java.lang.String">
        SELECT
            *
        FROM
            user
        WHERE
           role_id IN (SELECT id FROM role WHERE label = #{roleLabel})
    </select>
    <select id="selectByDeptId" resultType="com.qk.model.entity.User" parameterType="java.lang.Integer">
        SELECT
            *
        FROM
            user
        WHERE
            dept_id = #{deptId}
    </select>
</mapper>