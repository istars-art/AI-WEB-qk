<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qk.management.mapper.RoleMapper">
    <insert id="insert" parameterType="com.qk.model.entity.Role">
        INSERT INTO
            role(
                name,
                label,
                remark,
                create_time,
                update_time
            )
        VALUES(
                #{name},
                #{label},
                #{remark},
                #{createTime},
                #{updateTime}
            )
    </insert>
    <update id="updateById" parameterType="com.qk.model.entity.Role">
        UPDATE
            role
        SET
            name = #{name},
            label = #{label},
            remark = #{remark},
            update_time = #{updateTime}
        WHERE
            id = #{id}
    </update>
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE
            FROM
                role
            WHERE
                id = #{id}
    </delete>
    <select id="selectByAndCondition" resultType="com.qk.model.entity.Role">
        SELECT
            *
        FROM
            role
        <where>
            <if test="name != null">
                AND name LIKE concat('%',#{name},'%')
            </if>
            <if test="label != null">
                AND label LIKE concat('%',#{label},'%')
            </if>
        </where>
        ORDER BY
            role.update_time DESC
    </select>
    <select id="selectById" resultType="com.qk.model.entity.Role" parameterType="java.lang.Integer">
        SELECT
            *
        FROM
            role
        WHERE
            id = #{id}
    </select>
    <select id="selectByOrCondition" resultType="com.qk.model.entity.Role">
        SELECT
            *
        FROM
            role
        WHERE
            name = #{name}
            OR label = #{label}
    </select>
    <select id="selectByOrConditionExcudeId" resultType="com.qk.model.entity.Role">
        SELECT
            *
        FROM
            role
        WHERE
            (name = #{name} OR label = #{label})
            AND id != #{id}
    </select>
    <select id="selectAll" resultType="com.qk.model.entity.Role">
        SELECT
            *
        FROM
            role
    </select>
</mapper>